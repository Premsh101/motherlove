DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@your-neon-host.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
JWT_SECRET="your_super_secret_jwt_key_here"
PORT=5030
FRONTEND_URL="http://your-frontend-url:3030"
# To allow multiple origins, use a comma-separated list:
# FRONTEND_URL="http://your-frontend-url:3030,http://another-origin:3030"

# --- Schema auto-sync ---
# On startup the backend diffs the live database against src/models/schema.ts
# and creates any missing tables/columns/enums. Set to false to disable.
AUTO_MIGRATE=true
# On startup the backend creates the sample admin/doctor/patient accounts if
# they do not exist. Existing rows are never modified. Set to false to disable.
AUTO_SEED=true
# Set to true to abort startup when the schema sync or seed fails (default:
# warn and start against the existing schema).
MIGRATE_STRICT=false
